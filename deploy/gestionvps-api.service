[Unit]
Description=GestionVPS HTTPS administrative API
After=gestionvps-agent.service network-online.target
Requires=gestionvps-agent.service

[Service]
User=gestionvps
Group=gestionvps
WorkingDirectory=/opt/gestionvps/backend
ExecStart=/opt/gestionvps/venv/bin/uvicorn api:app --host 0.0.0.0 --port 8443 --ssl-certfile /etc/gestionvps/server.crt --ssl-keyfile /etc/gestionvps/server.key --no-access-log --no-proxy-headers
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gestionvps-api
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
