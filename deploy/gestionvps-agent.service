[Unit]
Description=GestionVPS local privileged WireGuard agent
After=network-online.target wg-quick@wg0.service wg-qos.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=gestionvps
WorkingDirectory=/opt/gestionvps/backend
ExecStart=/usr/bin/python3 /opt/gestionvps/backend/agent.py
Restart=on-failure
RestartSec=5
RuntimeDirectory=gestionvps
RuntimeDirectoryMode=0750
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/wireguard /var/lib/gestionvps-agent /run/gestionvps
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
